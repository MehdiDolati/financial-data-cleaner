{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-data-cleaner.local/contracts/market-calendar.schema.json",
  "title": "Weekly Market Calendar",
  "description": "Recurring weekly trading sessions without holiday exclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "timeZone", "sessions"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA time-zone identifier, for example America/New_York or UTC."
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "day": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ]
    },
    "localTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$",
      "description": "Local wall-clock time as HH:mm or HH:mm:ss."
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openDay", "openTime", "closeDay", "closeTime"],
      "properties": {
        "openDay": { "$ref": "#/$defs/day" },
        "openTime": { "$ref": "#/$defs/localTime" },
        "closeDay": { "$ref": "#/$defs/day" },
        "closeTime": { "$ref": "#/$defs/localTime" }
      }
    }
  }
}